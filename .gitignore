# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ── 工程内自包含工具链与虚拟环境 ──────────────────────────────────────────
# .tools/ 由本机沙箱限制产生（系统路径写入被拦截），不入库；新环境按规格附录 C 重建。
.venv/
.tools/

# ── 内容寻址产物 ──────────────────────────────────────────────────────────
# 派生产物，可由参数 + 内核版本 + 数据快照哈希重建（规格 §4.1）。
artifacts/*

# ── 前端 ──────────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/coverage/
*.tsbuildinfo

# ── 桌面打包产物 ──────────────────────────────────────────────────────────
# PyInstaller onedir 输出（数百 MB 二进制），可由 desktop/packaging/aeroforge.spec 重建（规格 §16.2）。
dist-desktop/
# NSIS 安装包输出（数百 MB 安装器），可由 desktop/packaging/aeroforge.nsi 重建（规格 §16 M7）。
desktop/packaging/dist/

# AI 助手运行时配置（OI-10：用户自填 base_url / api_key，明文密钥不入库）。
data/assistant.json

# ── 运行时噪声 ────────────────────────────────────────────────────────────
# Chromium / WebView2 子进程会把自身日志写到当前工作目录，非本工程产物（实测为搜狗输入法
# 相关的 kernel_parameter_setter 警告）。不要入库，也不要据此排查本项目问题。
debug.log

# ── 编辑器 / 系统 ─────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
Thumbs.db
Desktop.ini
